#!/bin/sh
# Rejects AI attribution trailers and tool signatures in commit messages.
msg_file="$1"
if grep -iE '^(co-authored-by|signed-off-by|generated-by|authored-by):.*(claude|anthropic|gemini|copilot|codex|openai|chatgpt|gpt|cursor|ai assistant|bot)' "$msg_file" >/dev/null; then
  echo "commit-msg: AI attribution trailer found. Remove it. See GIT_RULES.md §1." >&2
  exit 1
fi
if grep -iE 'generated with|🤖|noreply@anthropic|anthropic\.com|generated by (claude|gemini|copilot|codex|chatgpt)' "$msg_file" >/dev/null; then
  echo "commit-msg: tool signature found in message. Remove it. See GIT_RULES.md §1." >&2
  exit 1
fi
first=$(grep -v '^#' "$msg_file" | sed '/^\s*$/d' | head -1)
if [ -z "$first" ]; then echo "commit-msg: empty message." >&2; exit 1; fi
if [ ${#first} -gt 72 ]; then echo "commit-msg: subject is ${#first} chars; keep it ~50, max 72." >&2; exit 1; fi
exit 0
