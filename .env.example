# Triagedesk configuration.
# Copy this file to ".env" in the same folder (the repo root) and fill in what you have. Then run:
#   pnpm check:env    (shows which settings are present; never prints their values)
#   pnpm dev          (web app on http://localhost:5173, server on http://localhost:4000)
# ".env" is git-ignored. Never commit it, and never paste its values into chats or issues.
#
# Variables that start with VITE_ are built into the web app and are visible in the browser, so only
# public identifiers go there (OAuth client IDs are public by design). Everything else stays on the server.

# ---------- Web app: public identifiers ----------
# Gmail + Google Calendar: OAuth 2.0 Client ID of type "Web application" (ends in .apps.googleusercontent.com).
# Authorised JavaScript origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
# Outlook mail + calendar: Microsoft Entra "Application (client) ID".
# Platform "Single-page application", redirect URI: http://localhost:5173
VITE_MS_CLIENT_ID=
# The Triagedesk server (below). Needed for Yahoo Mail and the AI assistant.
VITE_API_URL=http://localhost:4000

# ---------- Server: secrets (never prefix these with VITE_) ----------
PORT=4000
# The web app's address, for CORS and the Yahoo sign-in window.
WEB_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Any long random string. Encrypts the mailbox tokens the server keeps in memory.
SESSION_SECRET=
# AI assistant: an API key from https://aistudio.google.com (Get API key). Empty = rules only.
# On the free tier Google may use prompts to improve its products; use a paid key for private mail.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Yahoo Mail (IMAP/SMTP with OAuth). Yahoo must approve Mail access for your app, and usually wants an
# https redirect, so this normally points at the deployed server: https://<server>/providers/yahoo/callback
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:4000/providers/yahoo/callback
# Optional: only the case-evaluation API (/runs) uses a database. Leave empty to run without one.
MONGODB_URI=
