# Prefer the single repo-root .env (copy /.env.example). This file is only for running the API on its own.
# Copy to apps/api/.env (never commit .env).
PORT=4000
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/c16?retryWrites=true&w=majority
# No Atlas yet? Run `pnpm dev:db` in another terminal and use the local one:
MONGODB_URI=mongodb://127.0.0.1:27017/c16
# Comma-separated list of allowed frontend origins (add the Amplify URL when deployed).
CORS_ORIGIN=http://localhost:5173
# Optional AI email-type check (Gemini free tier; synthetic data only). Leave empty for rules only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# The web app's origin, for credentialed CORS and the Yahoo sign-in popup (comma-separate several in CORS_ORIGIN).
WEB_ORIGIN=http://localhost:5173
# Encrypts provider tokens kept in server memory. Use a long random value in production.
SESSION_SECRET=
# Yahoo Mail (IMAP/SMTP over OAuth 2.0). Create an app at developer.yahoo.com with Mail access (Yahoo must approve it).
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:4000/providers/yahoo/callback
