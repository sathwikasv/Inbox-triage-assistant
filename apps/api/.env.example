# Copy to apps/api/.env (never commit .env).
PORT=4000
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/c16?retryWrites=true&w=majority
# No Atlas yet? Run `pnpm dev:db` in another terminal and use the local one:
MONGODB_URI=mongodb://127.0.0.1:27017/c16
# Comma-separated list of allowed frontend origins (add the Amplify URL when deployed).
CORS_ORIGIN=http://localhost:5173
# Optional AI email-type check (Gemini free tier; synthetic data only). Leave empty for rules only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
